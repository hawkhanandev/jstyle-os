# Copy to .env for local overrides, or on the server (mode 600). Never commit real values.
# Local: everything works with no .env at all.

# The only account allowed to sign in. Locally any address works with "Local sign-in".
JSTYLE_ALLOWED_EMAIL=owner@jstyle.local

# Real Google sign-in (optional locally, required on staging and production)
JSTYLE_GOOGLE_CLIENT_ID=
JSTYLE_GOOGLE_CLIENT_SECRET=

# Signs the OAuth state cookie. Generate with: openssl rand -hex 32
JSTYLE_SECRET_KEY=
